{
  "ConnectionStrings": {
    "FulfilmentCenterDatabase": "Server=localhost;Database=mydb;User=root;Password=my-secret;Port=3308;",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/messenger-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}